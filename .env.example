# Binance Spot Testnet (https://testnet.binance.vision/)
BINANCE_API_KEY=your_testnet_api_key
BINANCE_API_SECRET=your_testnet_api_secret
BINANCE_BASE_URL=https://testnet.binance.vision

# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key
# Optional: tried first, then fallback list below
GEMINI_MODEL=gemini-2.5-flash
# Comma-separated fallback models (free tier; some may be unavailable)
GEMINI_MODELS=gemini-3.5-flash,gemini-3.1-flash-lite-preview,gemini-3-flash-preview,gemini-2.5-flash-lite,gemini-2.5-flash

# Trading
SYMBOL=BTCUSDT
INTERVAL=15m
KLINES_LIMIT=50
LOOP_INTERVAL_SEC=900
QUOTE_ORDER_QTY=50
TRADE_PERCENT=0
MAX_TRADES_PER_DAY=10
COOLDOWN_MINUTES=30
MIN_CONFIDENCE=0.6

# Execution (set false to only log signals without placing orders)
EXECUTE_ORDERS=true
